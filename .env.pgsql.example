APP_NAME=XFrame
APP_PORT=8000
APP_WORKERS=4
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xframe
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

XFRAME_TOKEN_TTL=86400
XFRAME_REFRESH_TOKEN_TTL=2592000
XFRAME_DEFAULT_PASSWORD=123456
# Token 加密密钥，生产环境务必改为随机字符串（如：php -r "echo bin2hex(random_bytes(16));"）
XFRAME_TOKEN_KEY=
